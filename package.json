{
  "name": "chce",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:worker && npm run test:unit && npm run test:e2e",
    "test:worker": "node --test \"worker/test/*.test.mjs\"",
    "test:unit": "node tests/util.test.mjs",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-chce \"playwright test\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "firebase-tools": "15.34.2",
    "linkedom": "0.18.15",
    "wrangler": "4.153.0"
  }
}
